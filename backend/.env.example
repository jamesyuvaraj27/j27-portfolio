# --- Database (Neon Postgres) ---
# Get this from your Neon project dashboard -> Connection string (use the "pooled" one for DATABASE_URL)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/j27portfolio?sslmode=require
# Neon also gives a "direct" (non-pooled) connection string - Prisma migrate needs this one
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/j27portfolio?sslmode=require

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
NODE_ENV=development
PORT=5001

# --- CORS ---
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Cloudinary (required for image/resume uploads to persist) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (contact form notifications, optional) ---
EMAIL_USER=
EMAIL_PASSWORD=

# --- Seed admin user (used once by prisma/seed.js) ---
SEED_ADMIN_NAME=J27
SEED_ADMIN_EMAIL=jamesyuvaraj27@gmail.com
SEED_ADMIN_PASSWORD=Msjy-.2718@
